# UBICACIÓN: OmniaMentis/.env.example
# PROPÓSITO: Plantilla de variables de entorno. Este archivo SÍ se
#            commitea (no contiene secretos reales). Cópialo a .env
#            y complétalo, o mejor, deja que scripts/set_fons_password.py
#            genere FONS_PASSWORD_HASH y FONS_SECRET_KEY por ti.
# ÚLTIMA MODIFICACIÓN: 2026-07-05
#
# IMPORTANTE: el archivo .env real (sin ".example") NUNCA debe
# commitearse — ya está cubierto por la línea ".env" en .gitignore.
# Verifica que sigue así con: git check-ignore -v .env

# Generados automáticamente por: python scripts/set_fons_password.py
# No los escribas a mano — el script los genera con el formato correcto.
FONS_PASSWORD_HASH=
FONS_SECRET_KEY=

# Opcionales — ya tienen valor por defecto en main_flask.py si se omiten
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
OLLAMA_TIMEOUT=120
PORT=8000
